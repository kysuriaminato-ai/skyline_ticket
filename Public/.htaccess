<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /skyline_ticket/public/

# Không rewrite nếu là file hoặc thư mục thực sẽ
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route /admin/* đến admin.php
RewriteRule ^admin(/.*)?$ admin.php?url=admin$1 [QSA,L]

# Route các request khác đến index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>